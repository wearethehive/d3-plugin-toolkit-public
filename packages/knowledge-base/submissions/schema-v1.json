{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveschool.one/schemas/d3-toolkit-kb-submission-v1.json",
  "title": "d3 Toolkit KB Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "createdAt",
    "submissionId",
    "uploadDestination",
    "toolkit",
    "environment",
    "probe",
    "result",
    "proposedKbEntry",
    "redaction",
    "consent"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "d3-toolkit-kb-submission" },
    "createdAt": { "type": "string", "format": "date-time" },
    "submissionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,160}$"
    },
    "uploadDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "note"],
      "properties": {
        "site": { "const": "https://hiveschool.one" },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "toolkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cliVersion", "repoCommit"],
      "properties": {
        "cliVersion": { "type": "string", "maxLength": 40 },
        "repoCommit": { "type": "string", "maxLength": 40 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "nodeVersion", "designer"],
      "properties": {
        "os": { "type": "string", "maxLength": 40 },
        "nodeVersion": { "type": "string", "maxLength": 40 },
        "designer": { "type": ["object", "string", "null"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fileName",
        "relativePath",
        "sourceSha256",
        "sourceIncluded",
        "api",
        "suggestedEntryType",
        "startedAt",
        "completedAt",
        "durationMs",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fileName": {
          "type": "string",
          "pattern": "^[^\\\\/]+\\.py$",
          "maxLength": 160
        },
        "relativePath": { "type": "string", "maxLength": 300 },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceIncluded": { "const": false },
        "api": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 20
        },
        "suggestedEntryType": {
          "enum": ["pattern", "bug", "api", "unknown"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "status": { "enum": ["completed", "api-error"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "status", "returnValue", "pythonLog", "d3Log", "summary"],
      "properties": {
        "statusCode": { "type": "integer" },
        "status": { "type": "object" },
        "returnValue": {},
        "pythonLog": { "type": ["string", "null"], "maxLength": 20000 },
        "d3Log": { "type": ["string", "null"], "maxLength": 20000 },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "proposedKbEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "markdown"],
      "properties": {
        "type": { "enum": ["pattern", "bug", "api", "unknown"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "markdown": { "type": "string", "maxLength": 20000 }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "rules", "redactionCount", "warnings"],
      "properties": {
        "applied": { "const": true },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redactionCount": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectedByWebsite",
        "rightsConfirmed",
        "publicContributionAccepted"
      ],
      "properties": {
        "collectedByWebsite": { "const": true },
        "rightsConfirmed": { "const": false },
        "publicContributionAccepted": { "const": false }
      }
    }
  }
}
