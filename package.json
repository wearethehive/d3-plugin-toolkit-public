{
  "name": "d3-plugin-toolkit",
  "version": "0.1.1",
  "private": true,
  "license": "LicenseRef-HiveSchool-Source-Available-1.0",
  "description": "Toolkit for building Disguise Designer plugins with Vue, Vite, TypeScript, and guarded Designer Python workflows.",
  "workspaces": [
    "packages/cli",
    "packages/kb-mcp",
    "packages/shared",
    "packages/plugins/*"
  ],
  "scripts": {
    "build:cli": "npm -w packages/cli run build",
    "build:mcp": "npm -w packages/kb-mcp run build",
    "build:shared": "npm -w packages/shared run build",
    "cli": "node packages/cli/dist/index.js",
    "check:release-versions": "node scripts/check-release-versions.mjs --require-public --require-mcp",
    "check:release-versions:npm-available": "node scripts/check-release-versions.mjs --require-public --require-mcp --npm-available",
    "check:release-versions:npm-published": "node scripts/check-release-versions.mjs --require-public --require-mcp --npm-published",
    "dev:cli": "npm run build:cli --silent && node packages/cli/dist/index.js",
    "generate:kb-mcp-index": "node scripts/generate-kb-mcp-index.mjs",
    "mcp:kb": "node packages/kb-mcp/dist/index.js",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "vitest": "^4.1.4",
    "zod": "^4.3.6"
  }
}
